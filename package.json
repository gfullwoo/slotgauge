    "watch-sources": "node scripts/watch-sources.js",
    "extract": "node scripts/extract-state.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@google-cloud/storage": "^8.2.0",
    "cheerio": "1.0.0",
    "compression": "1.8.0",
    "express": "4.21.2",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^9.15.1",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "supertest": "7.1.0"
  }
}
