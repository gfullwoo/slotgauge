{
  "name": "slotgauge",
  "version": "0.1.0",
  "description": "SlotGauge - keep-or-release checks against official state fishing regulations",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:fake": "DEV_FAKE=1 node --watch server.js",
